# ==============================================================================
# applyforge — Environment Variable Reference
# ==============================================================================
# Copy this file to .env and fill in your values for local development.
#
#   macOS / Linux: cp example.env .env
#   Windows PowerShell: Copy-Item example.env .env
#
# .env is listed in .gitignore — it will NOT be committed to the repository.
# For GitHub Actions, set these as Secrets or Variables in the Actions settings.
# ==============================================================================


# ------------------------------------------------------------------------------
# REQUIRED — Must be set before running anything
# ------------------------------------------------------------------------------

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Full GCP service-account JSON as a single-line string.
# Used for Google Sheets access only (Drive uses OAuth2 credentials below).
# How to get it:
#   1. GCP Console → IAM & Admin → Service Accounts → Create
#   2. No project-level roles needed — share the spreadsheet directly instead
#   3. Create JSON key → download → paste entire file content here
#   Flatten to one line:
#   python -c "import json, pathlib; print(json.dumps(json.loads(pathlib.Path('key.json').read_text(encoding='utf-8')), separators=(',', ':')))"
GOOGLE_SERVICE_ACCOUNT=

# ID of the Google Spreadsheet to read from.
# Get it from the spreadsheet URL:
#   docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEET_ID=

# Google Drive folder ID where outputs will be uploaded.
# Get it from the folder URL: drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=

# Fallback folder name (only used if GOOGLE_DRIVE_FOLDER_ID is not set)
GOOGLE_DRIVE_PARENT_FOLDER=Applications


# ------------------------------------------------------------------------------
# GOOGLE OAUTH2 USER CREDENTIALS (recommended for personal Google Drive)
# ------------------------------------------------------------------------------
# Service accounts have no personal Drive storage quota — uploading to a regular
# "My Drive" folder with a service account causes a 403 storageQuotaExceeded error.
#
# OAuth2 user credentials fix this: uploads run as your real Google account,
# files are owned by you, and quota is charged to your Drive.
#
# One-time setup:
#   1. GCP Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID
#      → Application type: Desktop app → Download JSON → save as oauth_client.json
#   2. Run: python scripts/generate_refresh_token.py
#   3. Copy the printed values here (and into GitHub Secrets)
#   4. Delete oauth_client.json

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=


# ------------------------------------------------------------------------------
# SCHEDULING — Informational (actual cron is in .github/workflows/automation.yml)
# ------------------------------------------------------------------------------

# IANA timezone name — used in logs and for reference
APP_TIMEZONE=Asia/Dhaka

# Cron expression in UTC (this value is for documentation; edit the workflow YAML
# to actually change the schedule)
# "0 19 * * *" = 1:00 AM Bangladesh Standard Time (UTC+6)
CRON_SCHEDULE=0 19 * * *


# ------------------------------------------------------------------------------
# OPENAI SETTINGS
# ------------------------------------------------------------------------------

# Model to use for cover letter and email generation
# gpt-4o-mini is cost-efficient and high quality for this use case
# Alternatives: gpt-4.1-mini, gpt-4o
OPENAI_MODEL=gpt-4o-mini

# Generation temperature (0.0 = deterministic, 1.0 = creative)
# 0.7 balances professionalism with natural variation across applications
OPENAI_TEMPERATURE=0.7


# ------------------------------------------------------------------------------
# PROCESSING LIMITS
# ------------------------------------------------------------------------------

# Maximum number of "not applied" rows to process per workflow run
# Increase carefully — each job costs ~3-5 OpenAI API calls
MAX_JOBS_PER_RUN=10

# Seconds to sleep between processing consecutive jobs
# Prevents burst rate-limiting across OpenAI and Google APIs
RATE_LIMIT_DELAY=2


# ------------------------------------------------------------------------------
# NETWORK TIMEOUTS (seconds)
# ------------------------------------------------------------------------------

# Timeout for general HTTP requests
REQUEST_TIMEOUT=20

# Timeout specifically for job-page scraping (allow more for slow job boards)
SCRAPE_TIMEOUT=30


# ------------------------------------------------------------------------------
# RETRY COUNTS
# ------------------------------------------------------------------------------

# Number of retry attempts for OpenAI API calls
OPENAI_RETRIES=3

# Number of retry attempts for Google Sheets / Drive API calls
GOOGLE_RETRIES=3

# Number of retry attempts for web scraping
SCRAPE_RETRIES=2


# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Use DEBUG locally to see all details; INFO is fine for GitHub Actions
LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# RESUME PROFILES
# For GitHub Actions: set these as Repository Variables (not Secrets) under
#   Settings → Secrets and variables → Actions → Variables
# For local dev: paste the processed text content here
# Generate content with: python scripts/process_resume.py
# Add a RESUME_<TYPE> entry for each resume_type key used in your spreadsheet.
# ------------------------------------------------------------------------------

# Default / fallback profile (used when no type-specific variable is found)
RESUME_DEFAULT=

# Type-specific profiles
RESUME_BACKEND=
RESUME_AI=


# ------------------------------------------------------------------------------
# CUSTOM PROMPT OVERRIDES (optional)
# For GitHub Actions: set these as Repository Variables (not Secrets) under
#   Settings → Secrets and variables → Actions → Variables
# For local dev: paste your custom prompt text here
#
# If absent or empty, the built-in default prompt in services/prompts.py is used.
# User prompts (_USER) must still contain their required {placeholder} variables.
# See README "Custom Prompt Overrides" section for the full placeholder list.
# ------------------------------------------------------------------------------

# Override the system prompt used when compressing a raw PDF resume
PROMPT_RESUME_OPTIMIZER_SYSTEM=

# Override the user message template used when compressing a raw PDF resume
# Must contain: {resume_text}
PROMPT_RESUME_OPTIMIZER_USER=

# Override the system prompt used when generating cover letters
# Must contain: {resume_profile}
PROMPT_COVER_LETTER_SYSTEM=

# Override the user message template used when generating cover letters
# Must contain: {company}, {role}, {job_description}
PROMPT_COVER_LETTER_USER=

# Override the system prompt used when generating recruiter emails
# Must contain: {resume_profile}
PROMPT_RECRUITER_EMAIL_SYSTEM=

# Override the user message template used when generating recruiter emails
# Must contain: {company}, {role}, {job_description}
PROMPT_RECRUITER_EMAIL_USER=


# ------------------------------------------------------------------------------
# FILE SYSTEM PATHS (relative to project root)
# ------------------------------------------------------------------------------

# Where generated .md and .docx files are saved locally
OUTPUT_DIR=output

# Where daily log files are written
LOGS_DIR=logs

# Where optimized resume profiles (.txt) are stored for local dev fallback
RESUMES_DIR=resumes

# Where raw PDF resumes are placed for preprocessing
RAW_RESUMES_DIR=raw_resumes
